DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,kanafapp.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://kanafapp.pythonanywhere.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kanafapp.pythonanywhere.com
USE_PROXY_HEADERS=True
LOG_LEVEL=INFO
DATABASE_URL=postgres://kanaf_user:set-a-strong-database-password@db:5432/kanaf_db
DB_NAME=kanaf_db
DB_USER=kanaf_user
DB_PASSWORD=set-a-strong-database-password
DB_HOST=db
DB_PORT=5432
WEB_CONCURRENCY=2
WEB_THREADS=4
EMAIL_HOST_PASSWORD=replace-with-email-smtp-password
PHONE_OTP_THROTTLE=8/hour
# للتطوير المحلي فقط مع DEBUG=True: استخدم development لعرض OTP في اللوج.
# للإنتاج مع DEBUG=False: استخدم twilio أو مزود SMS حقيقي آخر.
SMS_BACKEND=twilio
SMS_DEFAULT_COUNTRY_CODE=+218
SMS_TIMEOUT=15
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-phone-number
# استخدم هذا بدلاً من TWILIO_FROM_NUMBER إذا كان لديك Messaging Service
TWILIO_MESSAGING_SERVICE_SID=
